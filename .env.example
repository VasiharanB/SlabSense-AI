APP_NAME=slabsense
ENVIRONMENT=local

# Gemini API configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_SECONDS=60

# Reliability configuration
GEMINI_MAX_RETRIES=1
GEMINI_RETRY_INITIAL_DELAY_SECONDS=1.0
GEMINI_RETRY_MAX_DELAY_SECONDS=4.0

# Database configuration
# Keep empty for local SQLite development.
# Docker Compose provides the PostgreSQL connection URL.
USAGE_DATABASE_URL=
USAGE_DATABASE_PATH=data/slabsense_usage.sqlite3

# PostgreSQL - Docker Compose
POSTGRES_DB=slabsense
POSTGRES_USER=slabsense_app
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

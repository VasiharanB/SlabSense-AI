APP_NAME=slabsense
ENVIRONMENT=local

# Gemini API configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_SECONDS=60

# Reliability configuration
GEMINI_MAX_RETRIES=1
GEMINI_RETRY_INITIAL_DELAY_SECONDS=1.0
GEMINI_RETRY_MAX_DELAY_SECONDS=4.0

# Database configuration
# Keep empty for local SQLite development.
# Docker Compose will provide the PostgreSQL connection URL.
USAGE_DATABASE_URL=

# Local SQLite fallback
USAGE_DATABASE_PATH=data/slabsense_usage.sqlite3

# PostgreSQL - Docker Compose
POSTGRES_DB=slabsense
POSTGRES_USER=slabsense_app
POSTGRES_PASSWORD=c41d455d2917fd578a6a90c2330b47a53a2bf76af863ae41

# Empty means local SQLite
USAGE_DATABASE_URL=
USAGE_DATABASE_PATH=data/slabsense_usage.sqlite3

POSTGRES_HOST=localhost
POSTGRES_PORT=5433